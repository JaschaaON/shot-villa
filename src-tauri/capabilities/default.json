{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte für alle App-Fenster",
  "windows": ["editor", "permission", "settings", "welcome", "thumbnail", "overlay-*", "pin-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-ignore-cursor-events",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
